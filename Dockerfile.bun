# syntax=docker/dockerfile:1

ARG BUN_IMAGE=oven/bun:1.4-alpine

FROM ${BUN_IMAGE} AS dependencies
WORKDIR /workspace/node-utils
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile

FROM dependencies AS source
WORKDIR /workspace/node-utils
COPY . .

FROM source AS builder
ARG VITE_APP_NAME
ENV VITE_APP_NAME=${VITE_APP_NAME}
RUN --mount=type=secret,id=app_env,required=true \
  bun --env-file=/run/secrets/app_env run build

FROM ${BUN_IMAGE} AS runtime
WORKDIR /app
ENV HOST=0.0.0.0
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=builder --chown=bun:bun /workspace/node-utils/.output ./.output
USER bun
EXPOSE 3000
CMD ["bun", ".output/server/index.mjs"]
