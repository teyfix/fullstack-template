APP_NAME="journal"
APP_SECRET="replace-this-local-secret"
APP_DOMAIN="${APP_NAME}.tail.gg"

APP_IMAGE="teyfix/fullstack-template:local"
BUN_IMAGE="oven/bun:1.3.14-alpine"
GOMPLATE_IMAGE="hairyhenderson/gomplate:v5.1.0-alpine"
IMGPROXY_IMAGE="ghcr.io/imgproxy/imgproxy:v4.0.3"
MINIO_IMAGE="minio/minio:RELEASE.2025-09-07T16-13-09Z"
PGBOUNCER_IMAGE="edoburu/pgbouncer:v1.25.2-p0"
POSTGRES_IMAGE="postgres:18.1-alpine"
REDIS_IMAGE="redis:8.4.0-alpine"

VITE_APP_NAME="${APP_NAME}"

BETTER_AUTH_SECRET="replace-this-with-at-least-32-random-characters"
BETTER_AUTH_URL="https://${APP_DOMAIN}"
BETTER_AUTH_ADMIN_USER_IDS=""

IMGPROXY_URL="https://imgproxy.${APP_DOMAIN}"
IMGPROXY_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
IMGPROXY_SALT="abcdef0123456789abcdef0123456789"

POSTGRES_DB="${APP_NAME}"
POSTGRES_USER="${APP_NAME}"
POSTGRES_PASSWORD="${APP_SECRET}"
PGBOUNCER_USER="pgbouncer_admin"
PGBOUNCER_PASS="${APP_SECRET}"
POSTGRES_ADMIN_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres.${APP_DOMAIN}:4040/${POSTGRES_DB}"
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer.${APP_DOMAIN}:4040/${POSTGRES_DB}"

REDIS_URL="redis://redis.${APP_DOMAIN}:4040"

S3_ACCESS_KEY="${APP_NAME}"
S3_BUCKET="${APP_NAME}"
S3_ENDPOINT="https://s3.${APP_DOMAIN}:4040"
S3_REGION="us-east-1"
S3_SECRET_KEY="${APP_SECRET}"
