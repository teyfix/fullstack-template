{
  "name": "@teyfix/fullstack-template",
  "version": "0.1.0",
  "private": true,
  "description": "A feature-oriented Bun, Solid, and TanStack Start application template.",
  "type": "module",
  "scripts": {
    "auth:generate": "bun x --bun auth generate --config ./src/feat/auth/auth.ts --output ./src/feat/auth/auth.generated.ts --yes",
    "build": "bun run generate && bun run typecheck:tsc && bun --bun vite build",
    "check": "bun x --bun biome check .",
    "commitlint": "bun x --bun commitlint",
    "db:check": "bun x --bun drizzle-kit check",
    "db:generate": "bun scripts/generate-migration.ts",
    "db:migrate": "bun x --bun drizzle-kit migrate",
    "db:prepare": "bun x --bun run-s db:migrate db:seed",
    "db:seed": "bun src/app/db/seed.ts",
    "dev": "bun run generate && bun x --bun run-p dev:features dev:start",
    "dev:features": "bun scripts/watch-features.ts",
    "dev:start": "bun --bun vite dev --port 3000",
    "features:sync": "bun scripts/sync-features.ts",
    "format": "bun run format:biome && bun run format:prettier",
    "format:biome": "bun x --bun biome check --write --unsafe .",
    "format:check": "bun run format:check:biome && bun run format:check:prettier",
    "format:check:biome": "bun x --bun biome check .",
    "format:check:prettier": "bun x --bun prettier --check \"**/*.{json,md,sh,sql,yaml,yml}\"",
    "format:prettier": "bun x --bun prettier --write \"**/*.{json,md,sh,sql,yaml,yml}\"",
    "generate": "bun x --bun run-s features:sync i18n:compile generate:routes",
    "generate:routes": "bun x --bun tsr generate",
    "hooks:check": "bun x --bun lefthook validate",
    "i18n:compile": "bun scripts/compile-messages.ts",
    "infra:check": "APP_ENV_FILE=$PWD/.env.example docker compose --env-file .env.example config -q",
    "lint": "bun x --bun biome lint .",
    "preview": "bun --bun vite preview",
    "start": "bun .output/server/index.mjs",
    "test": "bun x --bun run-s test:unit test:ui test:migrations",
    "test:migrations": "bun x --bun vitest run drizzle",
    "test:ui": "bun run generate && bun x --bun vitest run src/app src/feat",
    "test:unit": "bun run features:sync && bun test commitlint.config.test.ts drizzle.config.test.ts scripts src --preload ./test/setup.ts --path-ignore-patterns '**/*.test.tsx'",
    "typecheck": "bun run generate && bun run typecheck:tsc",
    "typecheck:tsc": "bun x --bun tsc --noEmit",
    "verify": "bun run format:check && bun run test && bun run typecheck && bun run db:check && bun run hooks:check"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0-rc.6",
    "@inlang/paraglide-js": "2.24.1",
    "@inlang/plugin-icu1": "1.1.0",
    "@kobalte/core": "0.13.13",
    "@tanstack/solid-form": "1.33.5",
    "@tanstack/solid-router": "1.170.27",
    "@tanstack/solid-start": "1.168.44",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@teyfix/drizzle": "github:teyfix/drizzle#v0.1.0",
    "@teyfix/paraglide-yaml": "https://github.com/teyfix/paraglide-yaml/releases/download/v0.1.1/teyfix-paraglide-yaml-0.1.1.tgz",
    "better-auth": "1.7.0-rc.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "nitro": "3.0.260610-beta",
    "qs": "6.15.3",
    "solid-js": "1.9.14",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.2",
    "@electric-sql/pglite": "0.5.5",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.30",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.4",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "@types/qs": "6.15.1",
    "auth": "1.7.0-rc.6",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "jsdom": "26.1.0",
    "lefthook": "2.1.10",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.6",
    "prettier-plugin-compact-markdown-table": "0.1.0",
    "prettier-plugin-embed": "0.5.1",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.19.0",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-sql": "0.20.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
